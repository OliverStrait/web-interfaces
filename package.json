{
  "name": "web-interfaces",
  "version": "0.2.2",
  "description": "collection of browser interfaces",
  "keywords": [
    "browser",
    "api"
  ],
  "homepage": "https://github.com/OliverStrait/web-interfaces#readme",
  "bugs": {
    "url": "https://github.com/OliverStrait/web-interfaces/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OliverStrait/web-interfaces.git"
  },
  "exports": {
    ".": "./src/index.js",
    "./storage/*": {
      "types": "./types/storage/*.d.ts",
      "import": "./src/storage/*.js"
    }
  },
  "license": "MIT",
  "author": "Olli Salmela",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "vitest",
    "test:once": "vitest run",
    "build:types": "tsc",
    "prebuild": "npm run test:once",
    "build": "npm run build:types && git add types",
    "post": "git push && git push --tags"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}