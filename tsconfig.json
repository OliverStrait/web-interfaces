{
    "compilerOptions": {
        "allowJs": true,
        "checkJs": true,
        "declaration": true,
        "emitDeclarationOnly": true,
        "outDir": "./types",
        "rootDir": "./src",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "target": "ESNext"
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "types"
    ]
}